#include "comm_can.h"

namespace xr {
namespace comm {

CanDevice::CanDevice(CAN_HandleTypeDef* hcan) : hcan_(hcan) {}

bool CanDevice::Send(uint32_t std_id, const uint8_t* data, uint8_t dlc) {
    if (!hcan_ || dlc > 8) return false;

    CAN_TxHeaderTypeDef header{};
    uint32_t mailbox;

    header.StdId = std_id;
    header.IDE = CAN_ID_STD;
    header.RTR = CAN_RTR_DATA;
    header.DLC = dlc;
    header.TransmitGlobalTime = DISABLE;

    return HAL_CAN_AddTxMessage(hcan_, &header, const_cast<uint8_t*>(data), &mailbox) == HAL_OK;
}

void CanDevice::StartRxInterrupt() {
    HAL_CAN_Start(hcan_);
    HAL_CAN_ActivateNotification(hcan_, CAN_IT_RX_FIFO0_MSG_PENDING);
}

void CanDevice::SetRxCallback(CanRxCallback cb) {
    rx_callback = cb;
}

void CanDevice::HandleRx() {
    CAN_RxHeaderTypeDef rx_header{};
    uint8_t rx_data[8]{};

    if (HAL_CAN_GetRxMessage(hcan_, CAN_RX_FIFO0, &rx_header, rx_data) == HAL_OK) {
        if (rx_callback) {
            rx_callback(rx_header.StdId, rx_data, rx_header.DLC);
        }
    }
}

}  // comm
}  // xr
