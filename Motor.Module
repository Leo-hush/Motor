#ifndef MOTOR_MODULE_H
#define MOTOR_MODULE_H

#include "comm_device.h"   // 用你的 CAN/UART 接口
#include "stm32f1xx_hal.h" // 改成你的芯片

namespace xr {
namespace motor {

class MotorDevice {
public:
    explicit MotorDevice(CommDevice* comm, uint32_t can_id = 0x201); 

    void SetCurrent(int16_t current);   
    void SetSpeed(int16_t speed);       
    void UpdateFeedback();            
    // 获取状态
    int16_t GetAngle() const { return angle_; }
    int16_t GetSpeed() const { return speed_; }
    int16_t GetCurrent() const { return current_; }
    int16_t GetTemp()   const { return temp_; }

private:
    CommDevice* comm_;
    uint32_t can_id_;
    int16_t angle_ = 0;
    int16_t speed_ = 0;
    int16_t current_ = 0;
    int16_t temp_ = 0;
};

}  // motor
}  // xr

#endif
