#include "comm_uart.h"

namespace xr {
namespace comm {

UartDevice::UartDevice(UART_HandleTypeDef* huart)
    : huart_(huart), rx_ring_buffer_{}, rx_head(0), rx_tail(0) {}

UartDevice::~UartDevice() {
    if (huart_) HAL_UART_Abort_IT(huart_);
}

int32_t UartDevice::Write(const uint8_t* data, uint32_t len, uint32_t timeout_ms) {
    HAL_StatusTypeDef status = HAL_UART_Transmit(huart_, const_cast<uint8_t*>(data), len, timeout_ms);
    return (status == HAL_OK) ? static_cast<int32_t>(len) : -1;
}

int32_t UartDevice::Read(uint8_t* buf, uint32_t max_len, uint32_t timeout_ms) {
    uint32_t rx_len = 0;
    HAL_StatusTypeDef status = HAL_UART_Receive(huart_, buf, max_len, timeout_ms);
    if (status == HAL_OK) rx_len = max_len;
    else if (status == HAL_TIMEOUT) rx_len = 0;
    return static_cast<int32_t>(rx_len);
}

void UartDevice::StartInterruptRx() {
    HAL_UART_Receive_IT(huart_, &rx_ring_buffer_[rx_head], 1);
}

void UartDevice::SetRxCallback(RxCallback cb) {
    callback = cb;
}

void UartDevice::ProcessRxByte(uint8_t byte) {
    rx_ring_buffer_[rx_head] = byte;
    rx_head = (rx_head + 1) % rx_ring_buffer_.size();

    if (callback) {
        callback(&byte, 1);
    }

    HAL_UART_Receive_IT(huart_, &rx_ring_buffer_[rx_head], 1);
}

}  
}  
